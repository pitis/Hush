#!/usr/bin/env bash
# No AI attribution in commit messages. [[:space:]] keeps this file from matching itself.
set -euo pipefail
if git stripspace --strip-comments <"$1" | grep -qiE 'co-authored-by:[[:space:]]*claude|generated with[[:space:]]+\[?claude'; then
  echo "✗ no AI attribution in commit messages" >&2; exit 1
fi
